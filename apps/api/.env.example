# Copy to .env for local development.

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Postgres via `docker compose up -d db` (host port 5433 keeps it clear of a
# native Postgres on 5432).
DATABASE_URL=postgresql://imix:imix@localhost:5433/imix?schema=public

# Payments. Without these the catalogue still runs and /payments/* answers 503.
# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
#
# The signing secret printed by `stripe listen --forward-to
# localhost:4000/payments/webhook`. Without it the webhook refuses every event.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Auth. Two separate secrets on purpose: a refresh token can then never be
# presented as an access token, or the other way round. Generate each with
#   openssl rand -base64 32
# Locally, a missing secret falls back to a dev value and logs a warning; in
# production the API refuses to start without them.
JWT_SECRET=
JWT_REFRESH_SECRET=

# The first ADMIN account, created by `pnpm --filter api db:seed`. Registration
# through the API always creates a plain USER, so this is the only way in.
# Re-seeding resets this account's password to whatever is written here.
ADMIN_EMAIL=admin@imix.local
ADMIN_PASSWORD=

# Phase 3 — asset storage
# CLOUDINARY_URL=
