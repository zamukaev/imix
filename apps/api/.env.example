# Copy to .env for local development.

PORT=4000
WEB_ORIGIN=http://localhost:3000

# Postgres via `docker compose up -d db` (host port 5433 keeps it clear of a
# native Postgres on 5432).
DATABASE_URL=postgresql://imix:imix@localhost:5433/imix?schema=public

# Payments. Without these the catalogue still runs and /payments/* answers 503.
# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
#
# The signing secret printed by `stripe listen --forward-to
# localhost:4000/payments/webhook`. Without it the webhook refuses every event.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Phase 3 — auth
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# Phase 3 — asset storage
# CLOUDINARY_URL=
