// iMIX data model — mirrors ARCHITECTURE.md §2 "Data model".
//
// Two cross-cutting rules shape the columns below:
//
//  1. Money is always stored in integer minor units (копейки / cents), never as
//     a float, and always *per currency*. There is no exchange rate anywhere in
//     this schema: the merchant sets the RUB price and the USD price, and a
//     buyer is charged exactly one of them.
//  2. Shopper-facing text is stored once per locale (`…Ru` / `…En`). The API
//     resolves one of them per request, so a DTO only ever carries one language.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 keeps the connection URL out of the schema: migrations read it from
// prisma.config.ts, the runtime client gets it through the pg driver adapter.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  CANCELLED
}

/// The currencies the shop quotes and settles in. Mirrors `Currency` in
/// @imix/types — adding a member here means adding a price column too.
enum Currency {
  RUB
  USD
}

/// Ground a home tile is drawn on. Mirrors `TileSurface` in the web primitive.
enum TileSurface {
  LIGHT
  WHITE
  DARK
}

/// Full-bleed tile, or one half of a pair. See ARCHITECTURE.md §5.1.
enum TileWidth {
  FULL
  HALF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique // "iphone", "mac" — locale-independent
  nameRu   String // "iPhone", "Аксессуары"
  nameEn   String // "iPhone", "Accessories"
  /// Order in the header. Alphabetical was fine while the sections were common
  /// nouns; now that they are product lines it puts Watch before iPad and reads
  /// as an accident. Not unique, and seeded in tens, for the same reasons as
  /// `HomeTile.position` — ties break on `slug`.
  position Int       @default(0)
  products Product[]
  groups   ProductGroup[]
}

/// A tab on a category page — "Laptops", "Desktops", "Displays" under Mac.
///
/// One level, not a tree: this exists to split a line-up that is too broad to
/// scan in one row, and a category that needs two levels of splitting is two
/// categories. Optional on `Product`, because most lines have nothing to split —
/// a category with fewer than two groups shows no tabs at all.
model ProductGroup {
  id         String    @id @default(cuid())
  slug       String
  nameRu     String
  nameEn     String
  /// Tab order, seeded in tens. Same reasoning as `Category.position`.
  position   Int       @default(0)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  // Unique per category rather than globally: "displays" under Mac and a future
  // "displays" under something else are different tabs.
  @@unique([categoryId, slug])
  @@index([categoryId, position])
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  nameRu        String
  nameEn        String
  descriptionRu String
  descriptionEn String
  /// One line for the model card on a category page. Nullable, and deliberately
  /// not derived from `description`: a first sentence cut out of running text
  /// was never written to stand on its own under a product name.
  taglineRu     String?
  taglineEn     String?
  brand         String // "Apple" — a brand name is not translated
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  /// Which tab of the category page this model sits under. Null means it shows
  /// under "all" only — which is every product in a category that has no tabs.
  groupId       String?
  group         ProductGroup?    @relation(fields: [groupId], references: [id])
  // Cheapest variant, denormalised for the catalogue grid. One column per
  // currency: see the header note — no rate, no conversion.
  basePriceRub  Int // minor units (копейки)
  basePriceUsd  Int // minor units (cents)
  images        String[]
  /// The model's chip in the category page's nav rail — a small cutout on a
  /// plain ground, which `images[0]` is not: a full-bleed marketing shot scaled
  /// to 56px is a coloured square. Null falls back to `images[0]`, so a category
  /// without cutouts still has a rail.
  navImageUrl   String?
  model3dUrl    String? // .glb for R3F viewer (Phase 5)
  featured      Boolean          @default(false)
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  sku        String      @unique
  labelRu    String // "256 ГБ · Чёрный титан"
  labelEn    String // "256GB · Black Titanium"
  color      String?
  config     String? // storage / RAM etc.
  priceRub   Int // minor units (копейки)
  priceUsd   Int // minor units (cents)
  stock      Int         @default(0)
  orderItems OrderItem[]
}

model Order {
  id                    String      @id @default(cuid())
  // Null for a guest checkout. Accounts arrive with auth in Phase 3; an order
  // placed before then keeps `email` as its only owner reference.
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  email                 String
  status                OrderStatus @default(PENDING)
  total                 Int
  // Frozen at checkout alongside `total` and every `priceAtPurchase`. What was
  // charged must stay readable even after the shopper switches currency.
  currency              Currency    @default(RUB)
  stripePaymentIntentId String?     @unique
  shippingName          String
  shippingAddress       String
  shippingCity          String
  shippingZip           String
  shippingCountry       String
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  priceAtPurchase Int // snapshot; never trust current price
}

/// One tile on the home page.
///
/// The shop window is content, not code: the admin owns this list so a seasonal
/// rearrangement does not need a deploy. The storefront renders it in order and
/// derives pairs from `width` — see the notes in ARCHITECTURE.md §2.
model HomeTile {
  id        String      @id @default(cuid())
  /// A stable, human-readable handle — "hero-iphone", "promo-watch".
  ///
  /// Independent of order on purpose: the seed and any future migration need a
  /// way to name one tile that does not change the moment somebody drags it up
  /// the page.
  key       String      @unique
  // Not unique on purpose: a unique constraint turns "swap two tiles" into a
  // three-step dance with a temporary value. Ties break on `id`, so the order
  // is still total and stable.
  position  Int
  published Boolean     @default(false)
  width     TileWidth   @default(FULL)
  surface   TileSurface @default(LIGHT)

  headlineRu String
  headlineEn String
  subheadRu  String?
  subheadEn  String?

  imageUrl   String
  // Usually empty — the headline already names the device. Filled in only when
  // the image carries something the copy does not.
  imageAltRu String?
  imageAltEn String?

  // Two CTAs at most, as columns rather than a child table: "one primary and one
  // ghost, never a third" is a design rule (ARCHITECTURE.md §5.3), and a child
  // table would let an admin add a fifth. A label without an href — or the other
  // way round — is an incomplete action and is dropped when the DTO is built.
  primaryLabelRu   String?
  primaryLabelEn   String?
  primaryHref      String?
  secondaryLabelRu String?
  secondaryLabelEn String?
  secondaryHref    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}
