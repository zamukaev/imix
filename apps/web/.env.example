# Copy to .env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where this shop is served from. Canonical links, hreflang and the sitemap are
# absolute URLs — a crawler has no request to resolve "/phones" against. Unset,
# it falls back to localhost, which is right in development and wrong the moment
# anything is deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Elements. Unset, /checkout renders but says payments are unavailable.
# Pairs with STRIPE_SECRET_KEY in apps/api/.env — both keys or neither.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
