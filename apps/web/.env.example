# Copy to .env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side only, and optional. Where a Server Component sends its requests
# when that is not the same address the browser should use — on the VPS the two
# apps are containers on one bridge, so SSR goes straight to `http://backend:4000`
# instead of out to the public hostname and back in through nginx. Unset, every
# request uses NEXT_PUBLIC_API_URL, which is right locally and on Vercel.
# API_INTERNAL_URL=http://backend:4000

# Where this shop is served from. Canonical links, hreflang and the sitemap are
# absolute URLs — a crawler has no request to resolve "/phones" against. Unset,
# it falls back to localhost, which is right in development and wrong the moment
# anything is deployed.
#
# On Vercel, set it for Production only. A preview build ignores it and uses its
# own VERCEL_URL instead — otherwise every preview would name production as its
# canonical — and serves a robots.txt that disallows everything.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Elements. Unset, /checkout renders but says payments are unavailable.
# Pairs with STRIPE_SECRET_KEY in apps/api/.env — both keys or neither.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
