# Template for /opt/imix/.env on the production VPS.
#
#   cp .env.production.example /opt/imix/.env && chmod 600 /opt/imix/.env
#
# This file is committed and therefore contains no value that is a secret. The
# real one lives only on the server: it is never in git, never in an image, and
# never in a GitHub Actions log.
#
# Note what is *absent*: NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SITE_URL and
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY. Next substitutes those into the browser
# bundle when the image is built, so they are build arguments in CI (GitHub
# repository *variables*, not secrets — they are public by definition) and
# setting them here would do nothing at all.

# --- identity ---------------------------------------------------------------

DOMAIN=YOUR_DOMAIN.ru
API_DOMAIN=api.YOUR_DOMAIN.ru

# Where the certificate expiry warnings go.
LETSENCRYPT_EMAIL=you@example.com

# `bootstrap` = plain HTTP, the only thing that works before a certificate
# exists. scripts/init-letsencrypt.sh flips this to `tls`.
NGINX_STAGE=bootstrap

# --- images -----------------------------------------------------------------

# Lowercase, always: GHCR rejects a capital letter in a repository path.
GHCR_NAMESPACE=ghcr.io/zamukaev

# The release currently running. CI rewrites this line to sha-<commit>; rolling
# back is putting the previous value here and running `up -d` again. `latest`
# works but tells you nothing about what is deployed, so keep a real tag.
IMAGE_TAG=latest

# --- database ---------------------------------------------------------------
#
# Generate the password with `openssl rand -hex 24`. Hex on purpose: `@`, `:`
# and `/` are structural characters in a connection URL, and a password
# containing one silently truncates DATABASE_URL instead of failing.

POSTGRES_USER=imix
POSTGRES_PASSWORD=
POSTGRES_DB=imix

# `db` is the compose service name, resolved on the internal network. Never
# localhost — inside a container that is the container itself.
DATABASE_URL=postgresql://imix:CHANGE_ME@db:5432/imix?schema=public

# --- api secrets ------------------------------------------------------------
#
# Two separate secrets on purpose, so a refresh token can never be presented as
# an access token. Generate each with `openssl rand -base64 32`. The API refuses
# to start in production without them — that is deliberate, not a bug to work
# around.

JWT_SECRET=
JWT_REFRESH_SECRET=

# The CORS allowlist, comma-separated. www redirects to the apex at the edge,
# but a request can still originate from either, and a browser checks the origin
# it sent — not the one it was redirected to.
WEB_ORIGIN=https://YOUR_DOMAIN.ru,https://www.YOUR_DOMAIN.ru

# --- first admin ------------------------------------------------------------
#
# Read only by the one-shot `seed` task. Registration through the API always
# creates a plain USER, so this is the only way an ADMIN comes into existence.
# Re-running the seed resets this account's password to whatever is here.

ADMIN_EMAIL=admin@YOUR_DOMAIN.ru
ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------

# Unset, uploads go to the imix-uploads volume and nginx serves them from
# /uploads/. Set it and Cloudinary takes over with no code change and no
# redeploy — but existing /uploads/ paths already in the database keep pointing
# at the volume, so do not delete it afterwards.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Payments. Without these /payments/* answers 503 and the rest of the shop is
# unaffected. Note the open question in CLAUDE.md: Stripe does not onboard
# Russian merchants, so this is very likely to become YooKassa or T-Bank.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
